{
  "expo": {
    "name": "Easy Health",
    "slug": "easy-health",
    "version": "1.0.0",
    "scheme": "easyhealth",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "br.com.easyhealth.app",
      "adaptiveIcon": {
        "backgroundColor": "#146B63"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Easy Health usa sua localização para encontrar hospitais, clínicas e UBS mais próximos, especialmente no Modo Emergência.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#146B63"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "O Easy Health precisa adicionar suas consultas ao calendário quando você solicitar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Easy Health acessa suas fotos somente para você escolher uma imagem de perfil."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5FAF8"
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "http://192.168.3.52:3333",
      "eas": {
        "projectId": "25c4d129-ea78-4043-9710-f91ee6233bb1"
      }
    },
    "owner": "joao-henrique5557"
  }
}

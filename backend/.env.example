# Para executar o backend diretamente na máquina (fora do Docker Compose).
# No Compose, o serviço backend recebe automaticamente uma URL usando o host "db".
DB_URL=jdbc:mysql://localhost:3306/easyhealth?serverTimezone=UTC&characterEncoding=UTF-8
DB_USER=easyhealth
DB_PASSWORD=replace-with-a-strong-password
CORS_ORIGIN=*
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
RESET_CODE_LOG_ENABLED=false

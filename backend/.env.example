# Copie para .env e ajuste os valores antes de subir o backend.

# String de conexão do PostgreSQL. Quando rodando via docker-compose, o host
# é o nome do serviço ("db"), não "localhost".
DATABASE_URL="postgresql://easyhealth:easyhealth@db:5432/easyhealth?schema=public"

PORT=3333

# Segredos de assinatura dos tokens JWT — troque por valores aleatórios
# fortes em produção (ex: `openssl rand -hex 32`).
JWT_ACCESS_SECRET="troque-este-segredo-de-access-token"
JWT_REFRESH_SECRET="troque-este-segredo-de-refresh-token"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Chave da API da Anthropic, usada pelo Assistente de IA
# (POST /api/assistant/message). Sem essa chave, a rota responde com uma
# mensagem de fallback em vez de travar o app.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Origem(s) permitida(s) para CORS, separadas por vírgula. "*" libera geral
# (ok para desenvolvimento; restrinja em produção).
CORS_ORIGIN="*"

# Copie este arquivo para ".env" na raiz do projeto antes de rodar
# `docker compose up`. O Compose lê automaticamente um arquivo ".env"
# na mesma pasta do docker-compose.yml para interpolar estas variáveis.

# --- Banco de dados (Postgres) ---
POSTGRES_USER=easyhealth
POSTGRES_PASSWORD=easyhealth
POSTGRES_DB=easyhealth
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3333
JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Chave da API da Anthropic para o Assistente de IA (seção 6.8 do readme).
# Sem essa chave, a rota /api/assistant/message responde com uma mensagem
# de fallback em vez de travar o app — o resto do backend funciona normalmente.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

CORS_ORIGIN=*

# Se "true", o container do backend popula o banco com dados de
# demonstração (mesmo conteúdo do design) no primeiro start.
SEED_ON_START=true

# --- Adminer (UI web para inspecionar o banco, opcional) ---
ADMINER_PORT=8080

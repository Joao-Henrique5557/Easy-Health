# Copie este arquivo para ".env" na raiz do projeto antes de rodar
# `docker compose up`. O Compose lê automaticamente um arquivo ".env"
# na mesma pasta do docker-compose.yml para interpolar estas variáveis.

# --- Banco de dados (Postgres) ---
POSTGRES_USER=easyhealth
POSTGRES_PASSWORD=easyhealth
POSTGRES_DB=easyhealth
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=3333
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
RESET_CODE_LOG_ENABLED=true

CORS_ORIGIN=*

# --- Adminer (UI web para inspecionar o banco, opcional) ---
ADMINER_PORT=8080
